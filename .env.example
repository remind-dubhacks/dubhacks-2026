# Copy to backend/.env and robot_worker/.env (only the keys each service needs). Never commit real values.

# --- backend ---
MONGODB_URI=            # MongoDB Atlas connection string; empty = in-memory demo (nothing persists)
MONGODB_DB=remind
ROBOT_WORKER_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=         # brain: tool calling (free tier at aistudio.google.com)
GEMINI_MODEL=gemini-flash-latest
ELEVENLABS_API_KEY=     # spoken replies; empty = browser voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
FIND_REMEMBER_OBJECTS=blue keychain,pink pen,white keycap   # Find & Remember props (names in games/find_remember.py)
FIND_REMEMBER_MOVER=simulated   # simulated | caregiver | robot

# --- robot_worker ---
ROBOT_MODE=mock         # mock | scripted | perceptron
REQUIRE_VERIFICATION=true
MOCK_DURATION_S=4
MOCK_FAIL_RATE=0
PERCEPTRON_API_KEY=
PERCEPTRON_DEPLOYMENT_ID=
SO101_PORT=             # e.g. /dev/tty.usbmodemXXXX
SO101_ID=remind_follower
LEADER_PORT=            # leader (teleop) arm
LEADER_ID=remind_leader
ARM_SPEED_DEG_S=30
GRIPPER_SPEED_S=60
MAX_RELATIVE_TARGET=10  # max degrees any joint may move per command
SIDE_CAMERA_INDEX=0
WRIST_CAMERA_INDEX=1
MAX_EPISODE_SECONDS=25
