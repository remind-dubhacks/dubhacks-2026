# Copy to backend/.env and robot_worker/.env (only the keys each service needs). Never commit real values.

# --- backend ---
MONGODB_URI=            # MongoDB Atlas connection string; needed to persist residents and care profiles. Empty = in-memory (resets on restart)
MONGODB_DB=remind
ROBOT_WORKER_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app   # allow the Vercel-hosted frontend
GEMINI_API_KEY=         # text agent only (/api/agent/turn); voice calls go through Backboard
GEMINI_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-3.8-live   # live (always-listening) mode
GEMINI_LIVE_VOICE=Aoede
ELEVENLABS_API_KEY=     # spoken replies; empty = browser voice
BACKBOARD_API_KEY=      # required for voice: all calls go through Backboard Realtime + patient memory (needs paid credits)
BACKBOARD_DIGEST_MODEL= # after-call fact extraction via Backboard, as provider/model; empty = Backboard's default
VOICE_TRANSPORT=        # ignored during development (Backboard only, see backend/app/voice/live.py)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- robot_worker ---
ROBOT_MODE=mock         # mock | scripted | perceptron
REQUIRE_VERIFICATION=true
MOCK_DURATION_S=4
MOCK_FAIL_RATE=0
PERCEPTRON_API_KEY=
PERCEPTRON_DEPLOYMENT_ID=
SO101_PORT=             # e.g. /dev/tty.usbmodemXXXX
SO101_ID=remind_follower
LEADER_PORT=            # leader (teleop) arm
LEADER_ID=remind_leader
ARM_SPEED_DEG_S=30
GRIPPER_SPEED_S=60
MAX_RELATIVE_TARGET=10  # max degrees any joint may move per command
SIDE_CAMERA_INDEX=0
WRIST_CAMERA_INDEX=1
MAX_EPISODE_SECONDS=25
